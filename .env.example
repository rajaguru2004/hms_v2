# ──────────────────────────────────────────────────────────────
# HMS v2 — Environment Variables Template
# Copy this file to `.env` and fill in the values for your VPS.
# ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_NAME="HMS v2"
APP_VERSION=2.0.0
API_PREFIX=api
CORS_ORIGINS=http://your-vps-ip-or-domain.com

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/hms_v2_prod"

# JWT — use a strong secret in production (min 32 chars)
# You can generate one using: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (used for caching/throttling)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_DB=0

# Seed Admin (used to seed the initial admin user, e.g. via `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@yourhospital.com
SEED_ADMIN_PASSWORD=Admin@HMS2024!

# Speak question translations that no clinician has reviewed yet (demo only).
MEDIHIVE_ALLOW_UNREVIEWED_PHRASEBOOKS=false

# ── Local AI ────────────────────────────────────────────────────────────────
# Every one of these is optional and defaults to on. A box with no Ollama still
# boots; it degrades rather than fails.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_SIDECAR_URL=http://127.0.0.1:8801

# The platform-wide switch. Off, this ALSO disables the Python sidecar, and the
# sidecar's Whisper, Piper and OCR are CPU-capable — so on a box with no GPU,
# leave this on and turn off the two document flags below instead.
AI_ENABLED=true

# Whether the medical-document pipeline may call a language model.
#
# Off, documents are read by deterministic extraction alone: a printed
# prescription or lab report is parsed end to end with no model, and the row
# records how much of the page was accounted for. This is the flag to set on
# GPU-less infrastructure.
MEDIHIVE_DOCUMENT_LLM_ENABLED=true

# The vision fallback for pages OCR could not read (handwriting, poor scans).
# The most expensive call in the feature and the first to turn off without an
# accelerator: there is no deterministic path behind it, so on a GPU-less box
# it buys a minutes-long wait and a transcript with no provenance.
MEDIHIVE_DOCUMENT_VISION_ENABLED=true
