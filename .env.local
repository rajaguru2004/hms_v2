# ──────────────────────────────────────────────────────────────
# HMS v2 — LOCAL developer overrides.
#
# This file is loaded FIRST by every env consumer (see prisma/env-paths.ts):
#   ['.env.local', '.env.development', '.env']
# and both dotenv and Nest take "first file to define a key wins", so every
# key set here beats the tracked `.env`.
#
# That is the entire point: the tracked `.env` points DATABASE_URL at the
# REMOTE PRODUCTION host 140.245.10.145, and every loader falls through to it
# when nothing earlier defines the key. This file is what stops a local
# `db:seed` from writing to production.
#
# Ports are NOT the canonical ones from docker-compose.local.yml: 5432 and
# 9000/9001 were already taken on this machine by unrelated containers, so the
# stack is brought up with docker-compose.local.ports.yml, which remaps them.
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="HMS v3"
APP_VERSION=2.0.0
API_PREFIX=api

# localhost:3000/3001 are the local web clients; the ngrok host is the public
# tunnel the Flutter app reaches this API through.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://convincedly-photometric-ariella.ngrok-free.dev

# Database — LOCAL docker postgres (hms_v2_postgres_local), host port 5442.
# Database name is hms_v2_dev, deliberately not hms_v2_prod.
DATABASE_URL="postgresql://db_user:db_password@localhost:5432/hms_v2_dev?schema=public"

# JWT — copied verbatim from the tracked `.env` so tokens stay interchangeable.
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=1440m
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis — LOCAL docker redis (hms_v2_redis_local), canonical port, no conflict.
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_DB=0

# Object storage — LOCAL MinIO (hms_v2_minio_local), API remapped to 9010.
# Console is at http://localhost:9011 (minio_admin / minio_password).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hmsbucket
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password

# Seed admin — copied from the tracked `.env`.
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@HMS2024!

# ── AI ────────────────────────────────────────────────────────────────────────
# Ollama is on 8080 here, not its default 11434. Both the backend and the
# sidecar default to 11434, so moving the server without setting these leaves
# the whole AI path pointed at a dead port — and the failure is quiet: the
# sidecar's circuit breaker reports the model as unavailable rather than
# erroring, so case-taking degrades to a plain questionnaire and nothing says
# why. The sidecar reads its own OLLAMA_URL from ai-sidecar/run.ps1.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:4b
AI_SIDECAR_URL=http://127.0.0.1:8801

# ── Demo only ─────────────────────────────────────────────────────────────────
# Speak UNREVIEWED question translations. `.env` keeps this false; this file is
# untracked and loads first, so the demo is switched on for this box and for
# nowhere else.
#
# What it means: Tamil and Hindi questions are machine-drafted and NO clinician
# who reads either language has checked them. One drift has already been found
# by inspection — the Hindi `hpi.severity` asks a breathlessness patient to rate
# their *pain*, where the English is deliberately symptom-neutral. Treat every
# translated question as unverified until `reviewedAt` carries a date.
MEDIHIVE_ALLOW_UNREVIEWED_PHRASEBOOKS=true

# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
# The streaming voice session: the phone joins a LiveKit room over WebRTC and a
# Python agent joins the same room to listen, transcribe and speak back.
#
# HERE and not in `.env`, and that is not tidiness. `.env` is tracked by git and
# its DATABASE_URL names the production database; an API secret committed there
# is an API secret published. The same split the unreviewed-phrasebook flag
# uses, for the same reason.
#
# The SECRET never leaves the server. The phone is issued a short-lived room
# token minted by the API — it never sees the key or the secret, because a
# credential shipped in an APK is a credential anyone with the APK holds.
LIVEKIT_URL=wss://ash10-n1k1vc5v.livekit.cloud
LIVEKIT_API_KEY=APIFCg8ySkqfnH9
LIVEKIT_API_SECRET=v2RcC7z9Rl23RTdZVzdXJTnfAnJBnMesyoXF6il7ecbB

# ── The voice agent's turn-taking ────────────────────────────────────────────
#
# How long a pause has to be before the patient's turn is treated as finished
# and the answer is sent. One second, because that is the hands-free feel being
# aimed for: speak, stop, and the question comes back without touching anything.
#
# The agent's own default is 650 ms and Silero's is 550. Both are quicker than
# this and both cut off somebody who pauses to find a word — which, in the
# middle of describing a symptom, is most people. Raising it trades a little
# latency for not interrupting the patient, and that is the right way round.
SILERO_MIN_SILENCE_MS=1000
