# Dependencies
node_modules/
.npm

# Build output
dist/
build/

# Environment files — NEVER commit real secrets

# `.env.local` is the per-machine override both the API (prisma/env-paths.ts)
# and the voice worker (voice-agent/config.py) load first, and every comment
# that names it calls it untracked. It was not: `.env.*.local` matches
# `.env.development.local` and not this, so the one file the codebase treats as
# the safe place for a local credential was the one file staged by `git add -A`.
.env.local
.env.*.local
.env.development
.env.staging
.env.production
# .env.test is OK to commit (no real secrets)

# Logs
logs/
*.log
npm-debug.log*

# Coverage
coverage/
.nyc_output

# IDE
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# OS
.DS_Store
Thumbs.db

# Prisma
# prisma/migrations/ is deliberately NOT ignored.
#
# It was, which meant a fresh clone had no migrations at all: `prisma migrate
# deploy` had nothing to apply and the only way to get a schema was
# `migrate dev`, which silently authors new migration files that then vanish
# into the ignore rule. The migration history is part of the schema, not build
# output.

# Docker
.docker/
hospital-management-system/