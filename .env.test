# ──────────────────────────────────────────────────────────────
# HMS v2 — Test Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=test
PORT=3001
APP_NAME="HMS v2 Test"
APP_VERSION=2.0.0
API_PREFIX=api
CORS_ORIGINS=*

# Separate test database — never run tests against dev/prod
DATABASE_URL="postgresql://hms_user:hms_password@localhost:5432/hms_v2_test?schema=public"

JWT_SECRET=test_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=test_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=60
REDIS_DB=1
