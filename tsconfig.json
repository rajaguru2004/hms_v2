{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictPropertyInitialization": false,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@config/*": ["src/config/*"],
      "@common/*": ["src/common/*"],
      "@prisma-lib/*": ["src/prisma/*"],
      "@modules/*": ["src/modules/*"],
      "@audit/*": ["src/audit/*"],
      "@cache/*": ["src/cache/*"],
      "@events/*": ["src/events/*"],
      "@jobs/*": ["src/jobs/*"]
    }
  },
  "exclude": ["node_modules", "dist", "hospital-management-system"]
}
