# ──────────────────────────────────────────────────────────────
# HMS v2 — Development Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="HMS v3"
APP_VERSION=2.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (Production Database in Docker)
DATABASE_URL="postgresql://db_user:db_password@140.245.10.145:5432/hms_v2_prod?schema=public"

# JWT — use a strong secret in production (min 32 chars)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=1440m
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (local)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_DB=0

# Seed (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@HMS2024!

# S3 Configuration
S3_ENDPOINT=https://hms.s3.skillhiveinnovations.com
S3_BUCKET=hmsbucket
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password


# Demonstration override: speak UNREVIEWED question translations (Hindi, Tamil).
# See src/modules/case-taking/engine/phrasebook.ts. Never true where real
# patients are interviewed — no clinician has checked this wording.
#
# `false` HERE and `true` in `.env.local`, and the split is the whole point.
# This file is TRACKED and its DATABASE_URL names the production database;
# `.env.local` is untracked and loads first, so the demo is on for this box and
# nowhere else. A demo flag committed as `true` is one nobody has to switch on
# to be affected by — it ships.
#
# This has now been flipped back to `true` twice by automated edits. If you are
# about to change it, you are almost certainly editing the wrong file: put the
# `true` in `.env.local`.
#
# What it actually enables: machine-drafted clinical questions no clinician who
# reads the language has checked. One drift is already known — the Hindi
# `hpi.severity` asks a breathlessness patient to rate their *pain*, where the
# English is deliberately symptom-neutral, and that field carries the highest
# red-flag weight in the section.
MEDIHIVE_ALLOW_UNREVIEWED_PHRASEBOOKS=false
