# ──────────────────────────────────────────────────────────────
# HMS v2 — Development Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="HMS v3"
APP_VERSION=2.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (Production Database in Docker)
DATABASE_URL="postgresql://db_user:db_password@140.245.10.145:5432/hms_v2_prod?schema=public"

# JWT — use a strong secret in production (min 32 chars)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=1440m
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (local)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_DB=0

# Seed (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@HMS2024!

# S3 Configuration
S3_ENDPOINT=https://hms.s3.skillhiveinnovations.com
S3_BUCKET=hmsbucket
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password


# Demonstration override: speak UNREVIEWED question translations (Hindi, Tamil).
# See src/modules/case-taking/engine/phrasebook.ts. Never true where real
# patients are interviewed — no clinician has checked this wording.
#
# `false` HERE and `true` in `.env.local`, and the split is the whole point.
# This file is TRACKED and its DATABASE_URL names the production database;
# `.env.local` is untracked and loads first, so the demo is on for this box and
# nowhere else. A demo flag committed as `true` is one nobody has to switch on
# to be affected by — it ships.
#
# This has now been flipped back to `true` twice by automated edits. If you are
# about to change it, you are almost certainly editing the wrong file: put the
# `true` in `.env.local`.
#
# What it actually enables: clinical questions in Tamil and Hindi that no
# clinician who reads those languages has signed off. `reviewedAt` is still
# null in `phrasebook.ts` for both, and that is the honest record — this flag
# says the deployment has decided to run them anyway, it does not say anybody
# checked them.
#
# The one drift this comment used to name has been fixed: the Hindi
# `hpi.severity` asked a breathlessness patient to rate their *pain* where the
# English is deliberately symptom-neutral, on the field with the highest
# red-flag weight in its section. Tamil had reproduced it and no longer does.
# Both now say "the worst state you can imagine" rather than "the worst pain".
# That is one drift found by reading; the rest is what a reviewer is for.
#
# Turned on here because the interview is conducted in the patient's own
# language now — see `interviewLanguageFor`. With it off, a Tamil or Hindi
# patient is asked in English, which is what shipped before and is still a
# working interview.
MEDIHIVE_ALLOW_UNREVIEWED_PHRASEBOOKS=true
