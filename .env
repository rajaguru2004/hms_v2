# ──────────────────────────────────────────────────────────────
# HMS v2 — Development Environment
# ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_NAME="HMS v3"
APP_VERSION=2.0.0
API_PREFIX=api
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Database (Production Database in Docker)
DATABASE_URL="postgresql://db_user:db_password@140.245.10.145:5432/hms_v2_prod?schema=public"

# JWT — use a strong secret in production (min 32 chars)
JWT_SECRET=dev_jwt_secret_must_be_at_least_32_characters_long
JWT_EXPIRES_IN=1440m
JWT_REFRESH_SECRET=dev_refresh_secret_must_be_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# Redis (local)
REDIS_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300
REDIS_DB=0

# Seed (used by prisma/seed.ts)
SEED_ADMIN_EMAIL=admin@hms.local
SEED_ADMIN_PASSWORD=Admin@HMS2024!

# S3 Configuration
S3_ENDPOINT=https://hms.s3.skillhiveinnovations.com
S3_BUCKET=hmsbucket
S3_ACCESS_KEY=minio_admin
S3_SECRET_KEY=minio_password


# Demonstration override: speak UNREVIEWED question translations (Hindi, Tamil).
# See src/modules/case-taking/engine/phrasebook.ts. Never true where real
# patients are interviewed — no clinician has checked this wording.
#
# THE SPLIT THIS COMMENT USED TO DESCRIBE IS GONE. `.env.local` has been
# deleted in favour of one central env file, so there is no longer a local
# override that keeps a demo flag off a deployment: whatever is set here is
# what production runs. The old text said "`false` HERE and `true` in
# `.env.local`" — that arrangement no longer exists and cannot be relied on.
#
# It is currently `true`, and that was already true of the tracked file before
# the consolidation, so this is not a change the consolidation introduced. But
# it is now unambiguously the production value, and nothing else will override
# it. Set it to `false` if unreviewed Tamil and Hindi wording should not be
# spoken to real patients.
#
# What it actually enables: clinical questions in Tamil and Hindi that no
# clinician who reads those languages has signed off. `reviewedAt` is still
# null in `phrasebook.ts` for both, and that is the honest record — this flag
# says the deployment has decided to run them anyway, it does not say anybody
# checked them.
#
# The one drift this comment used to name has been fixed: the Hindi
# `hpi.severity` asked a breathlessness patient to rate their *pain* where the
# English is deliberately symptom-neutral, on the field with the highest
# red-flag weight in its section. Tamil had reproduced it and no longer does.
# Both now say "the worst state you can imagine" rather than "the worst pain".
# That is one drift found by reading; the rest is what a reviewer is for.
#
# Turned on here because the interview is conducted in the patient's own
# language now — see `interviewLanguageFor`. With it off, a Tamil or Hindi
# patient is asked in English, which is what shipped before and is still a
# working interview.
MEDIHIVE_ALLOW_UNREVIEWED_PHRASEBOOKS=true

# ── Local AI ────────────────────────────────────────────────────────────────
#
# Every variable here is optional with a default, on purpose: a box with no
# Ollama and no sidecar still boots. See `src/config/validation.schema.ts`.
#
# This is now the only env file — `.env.local` has been deleted — so every value
# here applies to this machine and to the deployment alike. `docker-compose.yml`
# passes the whole file to the container with `env_file`, and its `environment:`
# block overrides DATABASE_URL and REDIS_HOST to the compose service names.

# The platform-wide switch. LEAVE THIS ON unless you mean it.
#
# It does not only gate Ollama. `sidecar.client.ts` reads the same flag, and
# with it off `health()` returns null and every sidecar call throws — which
# takes Whisper and Piper with it, and those are what make the voice interview
# work. Both are CPU models and neither needs a GPU, so switching this off to
# spare a GPU-less box the cost of a language model costs speech-to-text and
# text-to-speech for nothing. The per-feature flags below are the ones to
# reach for instead.
#
# Document OCR is NOT gated by this, and the asymmetry is worth knowing. The
# document pipeline reads through `SidecarOcrClient`, which has its own
# `MEDIHIVE_SIDECAR_URL` and no enable flag; the gated `SidecarClient` is used
# only by case-taking. So uploaded documents are still OCR'd and still parsed
# deterministically with every AI flag in this file switched off.
AI_ENABLED=true

# Whether the medical-document pipeline may call a language model at all.
#
# `false` is the setting for GPU-less infrastructure, which is what this
# deployment runs on. Off, documents are read by deterministic extraction
# alone — `pipeline/rules-extractor.ts` parses a printed prescription or lab
# report end to end with no model, and the row records how much of the page it
# accounted for in `extraction.coverage`.
#
# This is a degradation and not a failure, and the envelope keeps the two
# apart: `extractionMethod` says which reader produced the values, and
# `escalation.modelEnabled` records that the model was switched off here
# rather than tried and broken. Without that second field, a thin extraction
# on this box and a thin extraction from a real outage look identical a month
# later.
#
# What it costs: handwritten prescriptions, and the narrative half of imaging
# reports, referral letters and consultation notes. Those escalate to the
# model when it is available and simply stay unread when it is not — the
# patient is told "we read part of this document", never that the page was
# empty.
MEDIHIVE_DOCUMENT_LLM_ENABLED=false

# The §9 vision fallback, for pages OCR could not read.
#
# Off for the same reason and more strongly. It is the most expensive call in
# the feature — a whole page as pixels through a 4B model — and unlike text
# extraction there is no deterministic path behind it, so without an
# accelerator it buys a minutes-long wait and then a transcript with no
# provenance, which §16 will not store anyway.
MEDIHIVE_DOCUMENT_VISION_ENABLED=false

# ── Carried over from .env.local during consolidation ───────────────────────
#
# `.env.local` is gone: this file is now the single source of truth, and it is
# what `docker-compose.yml` hands the container via `env_file`.
#
# WARNING on the two addresses below. They are `127.0.0.1`, which was correct
# when the API ran on the same host as Ollama and the Python sidecar. Inside a
# container 127.0.0.1 is the container itself, so both need a real address
# before speech or a language model works in the deployment — either a service
# name on the compose network, or host.docker.internal with an
# `extra_hosts: - "host.docker.internal:host-gateway"` entry, which is what
# docker-compose.demo.yml does.
#
# Left as-is rather than guessed: MEDIHIVE_DOCUMENT_LLM_ENABLED is false so the
# document pipeline never dials Ollama, and a wrong address here degrades
# case-taking rather than breaking the boot.
OLLAMA_URL=http://127.0.0.1:8080
OLLAMA_MODEL=gemma3:4b
AI_SIDECAR_URL=http://127.0.0.1:8801

